{
  "_profile": "fund_ambush_watchlist",
  "_phase": "W1",
  "_intent": "观察池埋伏：降纯热点入池，保留 weekly_candidates + sector_pools 与 xueqiu search 低权重补充",
  "_prod_merge": "Deep-merge these keys into ~/.agent-reach/daily_run_settings.json (user override). Repo default config/daily_run_settings.json already ships W1 values; prod only needs this snippet if local file predates M9 or re-enables hot sources.",
  "watchlist": {
    "hot_topic_adjust_enabled": false,
    "close_reorder_by_performance": false,
    "close_weak_rotation_enabled": true,
    "close_weak_rotation_max": 2,
    "negative_intel_remove_enabled": true,
    "xueqiu_hot_candidates_enabled": false,
    "xueqiu_search_candidates_enabled": true,
    "weekly_candidates_enabled": true,
    "weekly_candidates_min": 5,
    "weekly_candidates_max": 10,
    "eastmoney_screen_candidates_enabled": true,
    "excess_digest": {
      "enabled": true
    }
  },
  "plugins": {
    "eastmoney_screen_min_change_pct": 0.5
  },
  "week_forecast": {
    "validation_harness": {
      "auto_tighten_deploy_on_streak": true
    }
  },
  "ops": {
    "precheck_auto_sync": {
      "enabled": true,
      "git_pull": true,
      "pip_editable": true,
      "profile_path": "config/profiles/fund_ambush_watchlist.json"
    },
    "project_progress_feishu": {
      "enabled": true
    },
    "dev_project_progress_feishu": {
      "enabled": true
    },
    "quote_probe": {
      "enabled": true,
      "max_codes": 12,
      "push_warn": true
    }
  },
  "intraday": {
    "upper_band_trim": {
      "enabled": true,
      "near_upper_band_pct": 1.0,
      "sell_ratio": 0.25,
      "max_sell_ratio": 0.30,
      "once_per_symbol_per_day": true,
      "trigger_on_price_near_week_upper": true,
      "trigger_on_change_near_day_upper": true,
      "trigger_on_mss_near_forecast_upper": true,
      "mss_near_upper_pts": 2.0,
      "trigger_on_next_kronos_divergence_day": true
    }
  }
}
